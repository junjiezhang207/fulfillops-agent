APP_NAME=全域电商供应链智能履约多Agent平台
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=true
APP_ENV=production
ALLOW_INFRA_FALLBACK=false
ALLOW_DEMO_DATA=false
REQUIRE_REDIS=true
REQUIRE_MYSQL=true
REQUIRE_MILVUS=true
MYSQL_URL=mysql+pymysql://root:root@localhost:3306/multiship_agent
# Redis：用于 Agent 对话历史、工具缓存和接口速率限制
# 填写后 Agent 多轮对话历史在服务重启后仍可恢复，多实例部署时共享上下文和限流状态
# 生产模式必须配置 Redis；不可用时后端应直接启动失败
REDIS_URL=redis://localhost:6379/0
SHORT_TERM_MEMORY_TTL_SECONDS=86400
# 长期记忆：固定使用 MySQL 权威存储 + Milvus 语义索引
LONG_TERM_MEMORY_MYSQL_URL=mysql+pymysql://root:root@localhost:3306/multiship_agent
LONG_TERM_MEMORY_MILVUS_COLLECTION=long_term_memory_vectors_1024
LONG_TERM_MEMORY_MILVUS_ALIAS=ltm_milvus
LONG_TERM_MEMORY_VECTOR_DIMENSION=1024
LONG_TERM_MEMORY_TTL_DAYS=180
KNOWLEDGE_DIR=app/data/knowledge
# 附加只读知识目录，默认把根目录 knowledge_base 也纳入 RAG；多个目录用逗号分隔
KNOWLEDGE_EXTRA_DIRS=knowledge_base
KNOWLEDGE_RECURSIVE=true
KNOWLEDGE_WARMUP_ON_STARTUP=true
# RAG 向量存储：生产模式固定使用 Milvus
VECTOR_STORE_TYPE=milvus
MILVUS_URI=http://localhost:19530
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DATABASE=default
MILVUS_ALIAS=rag_knowledge_base
MILVUS_COLLECTION=knowledge_base_1024
MILVUS_UPSERT_MODE=true
MILVUS_OVERWRITE=false
MILVUS_BATCH_SIZE=100
MILVUS_TIMEOUT_SECONDS=10
MILVUS_SIMILARITY_METRIC=COSINE
MILVUS_CONSISTENCY_LEVEL=Session
MILVUS_DIM=1024  # 当前默认 embedding=text-embedding-v4，维度固定为 1024
LOG_LEVEL=INFO

# ==============================================================
# 模型网关配置
# 前端只选择模型 ID / 策略；API Key 只留在后端环境变量里
# ==============================================================
MODEL_GATEWAY_CONFIG_PATH=config/model_gateway.yaml
DEFAULT_LLM_MODEL_ID=deepseek-chat

# 模型网关会根据 config/model_gateway.yaml 里的 api_key_env 读取这些 Key。
# 启用哪个模型，就配置对应环境变量。
LLM_API_KEY=sk-xxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxx      # 云端 OpenAI Embedding / Chat 可用
# DASHSCOPE_API_KEY=sk-xxxxxxxx  # 阿里云百炼 Chat / Embedding / Reranker 共用
# KIMI_API_KEY=sk-xxxxxxxx
# JINA_API_KEY=jina_xxxxxxxxx     # 云端 Reranker 可用
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# 本地开源模型如果在 yaml 里配置 requires_api_key: false，则不需要配置 Key。

# 兼容旧版配置字段：建议优先使用模型网关。
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1
# DeepSeek V4 等思考模型会在后端自动透传 thinking disabled，降低首字等待时间。

# ==============================================================
# Agent 质量门配置
# 开启后低质量回答会自动带反馈重试；重试会增加一次主模型调用
# ==============================================================
AGENT_ENABLE_REFLECTION=true
AGENT_REFLECTION_THRESHOLD=0.65
AGENT_MAX_REFLECTION_RETRIES=1
